# Speech to text (deepgram.com)
DEEPGRAM_API_KEY=

# Who can talk to Saathi: comma separated, country code, no + or spaces, e.g. 919800000001
SAATHI_NUMBERS=

# WhatsApp channel: twilio (sandbox) or meta (Cloud API)
SAATHI_TRANSPORT=twilio

# Public base URL of this server (your tunnel), used for Twilio signatures and media links
PUBLIC_URL=

# Twilio WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API (developers.facebook.com, your app, WhatsApp, API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# 1 plays and shows replies on this Mac when the channel refuses them (testing)
SAATHI_PLAY_LOCALLY=0

# Public web chat ("Try it live" on the website): 1 to enable
SAATHI_WEB=0
# The only website allowed to call it
SAATHI_WEB_ORIGIN=https://malaydewangan09.github.io
# Requests per visitor per day, and in total per day
SAATHI_WEB_PER_VISITOR=6
SAATHI_WEB_PER_DAY=120
# Stable public address (ngrok.com, free static domain)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Groq (console.groq.com, free tier) powers the public web chat
GROQ_API_KEY=
