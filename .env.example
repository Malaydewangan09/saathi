# Copy to .env and fill in. See "Run it" in the README.

# Voice notes to text (deepgram.com, free credit)
DEEPGRAM_API_KEY=

# Who can talk to Saathi: your number, country code, no + or spaces, e.g. 919800000001 (comma separated for more)
SAATHI_NUMBERS=

# Twilio WhatsApp sandbox (console.twilio.com, Messaging, Try it out, WhatsApp)
SAATHI_TRANSPORT=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number, e.g. whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=

# Your tunnel address, e.g. https://xxxx.trycloudflare.com (changes each time the tunnel starts)
PUBLIC_URL=

# 1 plays replies on this Mac when WhatsApp refuses them (sandbox daily limit)
SAATHI_PLAY_LOCALLY=0

# Optional, instead of Twilio: Meta WhatsApp Cloud API (set SAATHI_TRANSPORT=meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
